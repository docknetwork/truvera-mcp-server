#!/bin/sh
set -e

# npm audit hits the registry over the network, so it belongs here (once per
# push) rather than in pre-commit (every commit). Only runs when this push
# actually changes package-lock.json.

z40=0000000000000000000000000000000000000000
LOCKFILE_CHANGED=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a ref — nothing to check
  if [ "$local_sha" = "$z40" ]; then
    continue
  fi

  if [ "$remote_sha" = "$z40" ]; then
    # New branch/tag on the remote — no prior state to diff against, so just
    # check whether package-lock.json exists at the tip being pushed.
    if git ls-tree -r --name-only "$local_sha" | grep -qx "package-lock.json"; then
      LOCKFILE_CHANGED=1
    fi
  else
    if ! git diff --quiet "$remote_sha" "$local_sha" -- package-lock.json; then
      LOCKFILE_CHANGED=1
    fi
  fi
done

if [ "$LOCKFILE_CHANGED" -eq 0 ]; then
  exit 0
fi

echo "package-lock.json changed in this push — running npm audit..."
node scripts/check-audit.js
