# Example environment variables for local development
# Copy this file to .env and update with your actual values

# Truvera API Configuration
TRUVERA_API_KEY=your-api-key-here
TRUVERA_API_ENDPOINT=https://api-testnet.truvera.io

# MCP Configuration
MCP_MODE=stdio
MCP_PORT=3000

# Node environment
NODE_ENV=development

# AP2 (Agent Payments Protocol) Configuration
# Set to false to disable AP2 support (verify_payment_mandate, issue_payment_token)
AP2_ENABLED=true
